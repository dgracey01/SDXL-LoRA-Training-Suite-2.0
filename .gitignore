# ── Virtual environment ────────────────────────────────────────────────────────
.venv/
.venv_zluda_backup/

# ── Python cache ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ── Downloaded models (auto-downloaded on first use) ──────────────────────────
tags/models/
tags/*.pth
randomizer/models/

# ── User config & data ─────────────────────────────────────────────────────────
tags/uth_config.json
tags/uth_profiles.json
randomizer/randomizer_config.json
calculator/training_log.json
randomizer/random images/
faces/faceswap_config.json
enhancer/enhancer_config.json
faces/inswapper_128.onnx
faces/GFPGANv1.4.pth
faces/models/
gfpgan/weights/detection_Resnet50_Final.pth
gfpgan/weights/parsing_parsenet.pth
gfpgan/weights/*.partial

# ── Secrets — never commit ─────────────────────────────────────────────────────
launcher/hf_config.json

# ── Dataset & working folders ──────────────────────────────────────────────────
dataset/
temp/

# ── Local workflow scripts ─────────────────────────────────────────────────────
push.bat

# ── Build artifacts ────────────────────────────────────────────────────────────
*.zip

# ── Stray image files in root ──────────────────────────────────────────────────
/*.png
/*.jpg
/*.jpeg
/*.webp
output.png

# ── Windows metadata ───────────────────────────────────────────────────────────
desktop.ini
Thumbs.db
ehthumbs.db

# ── IDE ────────────────────────────────────────────────────────────────────────
.vscode/
.vs/
.idea/
*.code-workspace
